            ],
            "private_ip": "10.0.1.10",
            "public_dns": "ec2-54-211-18-165.compute-1.amazonaws.com",
            "public_ip": "54.211.18.165",
            "region": "us-east-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/sda1",
                "encrypted": false,
                "iops": 100,
                "kms_key_id": "",
